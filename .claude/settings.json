{
  "language": "japanese",
  "forceLoginMethod": "claudeai",
  "plansDirectory": ".ai/plans",
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "codex",
    "project-context",
    "worktree-manager"
  ],
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git worktree list*)",
      "Bash(git worktree add*)",
      "Bash(git worktree remove*)",
      "Bash(git worktree prune*)",
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make ci*)",
      "Bash(python3 scripts/**)",
      "Bash(bash scripts/**)",
      "Bash(codex *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(git commit*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(curl http*)",
      "Bash(wget http*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*secret*)",
      "Read(./**/*password*)",
      "Read(./**/*token*)",
      "Read(./.git/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/bash_guard.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/log_ldd.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/log_ldd.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop_quality_gate.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/session_end.py"
          }
        ]
      }
    ]
  }
}
