{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI parallel dev plan",
  "type": "object",
  "required": [
    "plan_id",
    "created_at",
    "goal",
    "tasks"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "worktree",
          "owner",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "tdd-red",
              "tdd-green",
              "refactor",
              "docs",
              "ci",
              "security",
              "chore"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "worktree": {
            "type": "string"
          },
          "owner": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "hybrid"
            ]
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
